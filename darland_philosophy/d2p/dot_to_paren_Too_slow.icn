global dot, and, quan, log_c, lineno, sno_s, val_s, echo, sno_tmp, val_tmp, lextra, qextra, delimiter_quan_1, delimiter_quan_2, delimiter_log_1, delimiter_log_2, part0, part1, part2, part3, part4, part5, part6, part7, exe_max

procedure in_front(linein, symbol , quant_or_log, dots1_in, dots1_out, dots2_in, dots2_out)
   write(&errout, "in_front TOP linein = ",linein, " symbol = ",symbol)
   write(&errout, "quant_or_log = ", quant_or_log)
   write(&errout, "dots1_in = ", dots1_in)
   write(&errout, "dots1_out = ", dots1_out)
   write(&errout, "dots2_in = ", dots2_in)
   write(&errout, "dots2_out = ", dots2_out)

   chg := 1
   exe_max -:= 1
   if exe_max <= 0 then exit()
   while chg = 1 do {
      write(&errout, "DJDLINE TOP  = ", linein) 
      chg := 0
      if dots1_in ~== " " then {
         if (linein ? (
                     part0 := (tab(many(" ")) | tab(match(""))) &
                     write(&errout, "DJD0000 part0 = ", part0) &
                     part1 := tab(match(dots1_in)) & 
                     write(&errout, "DJD0001 part1 = ", part1) &
                     (tab(many(' ')) | "") &
                     part2 := tab(match(symbol)) & 
                     write(&errout, "DJD0002 part2 = ", part2) &
                     if (quant_or_log == "quant") then {
                        part3 := tab(many(delimiter_quant_1)) & 
                        write(&errout, "DJD0003 part3 = ", part3) &
                           part4 := tab(match("}")) &
                        write(&errout, "DJD0004 part4 = ", part4)
                        } 
                     else {
                        part3 := "" &
                        write(&errout, "DJD0003B part3 = ", part3) &
                           part4 := "" &
                        write(&errout, "DJD0004B part4 = ", part4) 
                        } &
                        part5 := tab(0))) then {
                           write(&errout, "DJD0005 part5 = ", part5) &
                           if part6 := in_rear(linein, symbol , quant_or_log, dots1_in, dots1_out, dots2_in, dots2_out) then {

                              linein := part0 || dots1_out || " TEMP " || part3 || part4 || part6
                              write(&errout, "DJDLINE A  = ", linein) &

                              chg := 1
                              next
                                 }
                           }
         
         }
      else { # dots1_in == " "
         if (linein ? (
                     if (quant_or_log == "quant") then {
                        part0 := (tab(many(" ")) | tab(match(""))) &
                           write(&errout, "DJD0000B part0 = ", part0) &
                           (tab(many(' ')) | "")
                        } 
                     else {
                        part0 := (tab(find(symbol))) &
                           write(&errout, "DJD0000C part0 = ", part0)
                        } &
                        part1 := "" &
                        part2 := tab(match(symbol)) & 
                        write(&errout, "DJD0002C part2 = ", part2) &
                        if (quant_or_log == "quant") then {
                           part3 := tab(many(delimiter_quant_1)) & 
                           write(&errout, "DJD0003C part3 = ", part3) &
                              part4 := tab(match("}")) &
                           write(&errout, "DJD0004C part4 = ", part4) 
                           } 
                        else {
                           part3 := "" &
                           write(&errout, "DJD0003D part3 = ", part3) &
                              part4 := "" &
                           write(&errout, "DJD0004D part4 = ", part4) 
                           } &
                           part5 := tab(0))) then {
                              write(&errout, "DJD0005D part5 = ", part5) &
                                 if part9 := in_rear(linein, symbol , quant_or_log, dots1_in, dots1_out, dots2_in, dots2_out) then {
                                    linein := part0 || dots1_out || " TEMP " || part3 || part4 || part9
                                    write(&errout, "DJDLINE B  = ", linein) 
                                    
                                    chg := 1
                                    next
                                       }
                              }
         }
      }
   return chg
end

procedure in_rear(linein, symbol , quant_or_log, dots1_in, dots1_out, dots2_in, dots2_out)
   exe_max -:= 1
   write(&errout, "DJD0005A part5 = ", part5)
   if exe_max <= 0 then exit()
   if dots2_in ~== " " then {
      if (part5 ? (part6 := (tab(many(" ")) | tab(match(""))) &
                   write(&errout, "DJD0006E part6 = ", part6) &
                   part7 := tab(match(dots2_in)) & 
                   write(&errout, "DJD0007E part7 = ", part7) &
                   part8 := tab(0)))
                   then {
                      write(&errout, "DJD0008E part8 = ", part8)
                      part9 := part6 || dots2_out || part8 &
                      write(&errout, "DJD0009E part8 = ", part9)
                      return part9
                      }
      }
   else #  dots2_in == " "
      if (part5 ? (part6 := (tab(many(" ")) | tab(match(""))) &
                   write(&errout, "DJD0006E part6 = ", part6) &
                   part7 := "" & 
                   write(&errout, "DJD0007E part7 = ", part7) &
                   part8 := tab(0)))
                   then {
                      write(&errout, "DJD0008E part8 = ", part8)
                      part9 := part6 || part8
                      write(&errout, "DJD0009E part8 = ", part9)
                      return part9
                      }
   fail
end

procedure main()
# next 2 lines used to get debugging from unicon
   &trace := 1000  # how many function calls to trace
   &dump := 1 # nonzero turns on termination dump
   init() 
   process()
   finish()
end
procedure init()
   exe_max := 3000000
   lextra := 0
   qextra := 0
   # initialize globals
   echo := 1 # show original line with dots next to one with parens  
   lineno := 0 # global as may be useful if error messages etc.
   # The following are used to identify strings used in latex - mostly principia 
   dot := table(0)
   dot[1] := " "
   dot[2] := "\\pmdot"
   dot[3] := "\\pmdott"
   dot[4] := "\\pmdottt"
   dot[5] := "\\pmdotttt"
   dot[6] := "\\pmdottttt"
   dot[7] := "\\pmdotttttt"

   and := table(0)
   and[1] := "\\pmand"
   and[2] := "\\pmandd"
   and[3] := "\\pmanddd"
   and[4] := "\\pmandddd"
   and[5] := "\\pmanddddd"
   and[6] := "\\pmandddddd"
   
   quan := table(0)
   quan[3] :=   "\\pmsome{"
   quan[2] :=   "\\pmall{"
   quan[1] :=   "\\dsc{"

   log_c := table(0)
   log_c[1] := "\\pmor"
   log_c[2] := "\\pmiff"
   log_c[3] := "\\pmimp"

   delimiter_log_1 := 'abcdefghijklmnopqrstuvwxyzABCDERGHIJKLMNOPQRSTUVWXYZ,_\\ '
   delimiter_log_2 := 'abcdefghijklmnopqrstuvwxyzABCDERGHIJKLMNOPQRSTUVWXYZ,_\\ '
   delimiter_quan_1 := 'abcdefghijklmnopqrstuvwxyzABCDERGHIJKLMNOPQRSTUVWXYZ,_\\ '
   delimiter_quan_2 := 'abcdefghijklmnopqrstuvwxyzABCDERGHIJKLMNOPQRSTUVWXYZ,_\\ '
#    delim := 'abcdefghijklmnopqrstuvwxyzABCDERGHIJKLMNOPQRSTUVWXYZ,_\\ '
#    delim2 := 'abcdefghijklmnopqrstuvwxyzABCDERGHIJKLMNOPQRSTUVWXYZ,_\\} '

   sno_s := table(0)
   val_s := table(0)

   val_s[1] := "."
   sno_s[1] := "@SNO.@" # Not expected in linein - may be changed if conflict
   val_s[2] := "^"
   sno_s[2] := "@SNO^@" # Not expected in linein - may be changed if conflict
   val_s[3] := "!"
   sno_s[3] := "@SNO!@" # Not expected in linein - may be changed if conflict
   val_s[4] := "%"
   sno_s[4] := "@SNO%@" # Not expected in linein - may be changed if conflict
   val_s[5] := ";"
   sno_s[5] := "@SNO;@" # Not expected in linein - may be changed if conflict
   val_s[6] := ":"
   sno_s[6] := "@SNO:@" # Not expected in linein - may be changed if conflict
   sno_s[7] := "@SNOpsi@"   
   val_s[7] := "\\psi"
   sno_s[8] := "@SNOalpha@"   
   val_s[8] := "\\alpha"
   sno_s[9] := "@SNObeta@"   
   val_s[9] := "\\beta"
   sno_s[10] := "@SNOgamma@"   
   val_s[10] := "\\gamma"
   sno_s[11] := "@SNOphi@"   
   val_s[11] := "\\phi"
   sno_s[12] := "@SNOphi@"   
   val_s[12] := "\\phi"
   sno_s[13] := "@SNOchi@"   
   val_s[13] := "\\chi"
   sno_tmp := "@SNOTEMP@" # Not expected in linein - may be changed if conflict
   val_tmp := "TEMP"
end

procedure finish()
end
procedure process()
   while linein := read() do { # read from standard in
      lineno +:= 1
      #      # write("% lineno ", lineno, " = ", linein)
      # only change lines with dots
      if find("\\pmand", linein) then a := 1 else a := 0
      if find("\\pmdot", linein) then b := 1 else b := 0
      if ((a + b) > 0) then {
         if echo = 1 then {
            write(linein)
            write(" ")
            }
         linein ? (front := tab(find(dot[2])) & linein := tab(0))
         

         # avoid any conflicts 
         av := 1
         while av <= *sno_s do {
            linein := avoid(linein,sno_s[av],val_s[av])
            av +:= 1
            }
         # write("%% HERE linein = ", linein)
         ## Next change possible leading dots
         if lineout := sub_dot_leading(linein, dot[6], " ^^^^^^ ")
         then linein := lineout
         else if lineout := sub_dot_leading(linein, dot[5],  " ^^^^^")
         then linein := lineout
         else if lineout := sub_dot_leading(linein, dot[4],   " ^^^^ ")
         then linein := lineout
         else if lineout := sub_dot_leading(linein, dot[3],    " ^^^ ")
         then linein := lineout
         else if lineout := sub_dot_leading(linein, dot[2],     " ^^ ")
         then linein := lineout
         else if lineout := sub_dot_leading(linein, dot[1],      " ^ ") 
         then linein := lineout
         # first change dots associated with quantifiers with to "!"
         # quantifiers must come first 
         # if not first they would already be changed to wrong value
         # also changes quantifier symbol to "TEMP" - to avoid getting stuck
         # would be better to find someting other than "TEMP"
         # longer number of dots done first
         # this is Group  II on page 9 of to *56
         # ! before quantifier % after

         chg := 1
         while chg = 1 do {
            iiii := *log_c
            while iiii >= 1 do {
               jjjj := *dot
               while jjjj >= 1 do {
                  kkkk := *dot
                  while kkkk >= 1 do {
                     chg := in_front(linein, log_c[iiii] , "log", dot[jjjj], ltranf(jjjj), dot[kkkk], ltranr(kkkk))
                     exe_max -:= 1
                     if exe_max <= 0 then exit()
                     }
                  kkkk -:= 1
                  }
               jjjj -:= 1
               }
            iiii -:= 1
            }
         
         chg := 1
         while chg = 1 do {
            iiii := *quan
            while iiii >= 1 do {
               jjjj := *dot
               while jjjj >= 1 do {
                  kkkk := *dot
                  while kkkk >= 1 do {
                     chg := in_front(linein, quan[iiii] , "quan", dot[jjjj], qtranf(jjjj), dot[kkkk], qtranr(kkkk))
                     exe_max -:= 1
                     if exe_max <= 0 then exit()
                     }
                  kkkk -:= 1
                  }
               jjjj -:= 1
               }
            iiii -:= 1
            }
         

         # Next change dots associated with conjunction to ";"
         # Group III on page 9 to *56
         linein := sub_dot(linein, and[6], ";;;;;; \\land ::::::")
         linein := sub_dot(linein, and[5],  ";;;;; \\land :::::")
         linein := sub_dot(linein, and[4],   ";;;; \\land ::::")
         linein := sub_dot(linein, and[3],    ";;; \\land :::")
         linein := sub_dot(linein, and[2],     ";; \\land ::")
         linein := sub_dot(linein, and[1],      "; \\land :")
#         # write("% POST06 linein after and = ", linein)
         linein := front || linein
         # next compute number of left parens to start with
         # total number of "!" or "."
         # ";" is neutral - produces same number of right or left paren
         # Later as analyze keep track of open and close paren
         # and add enough close paren to balance
         first_dots := scan(linein)
         # write("% before analyze linein = ", linein)
         # see comments within analyze
         lineout := analyze(first_dots, linein)
         # finally remove as many paren from left and right as possibe
         # we will have started with more opening paren than needed
         lineout := trim_excess(lineout)
         av := 1
         while av <= *sno_s do {
            restore_avoided(linein,sno_s[av],val_s[av]) # avoid should not occur in line
            av +:= 1
         }
         write(lineout)
         }
      else write(linein)      
      }
end

procedure qtranf(jjjj)
   return(" " || repl("!", jjjj + qextra - 1) || " ")
end
   
procedure qtranr(kkkk)
   return(" " || repl("%", kkkk + qextra - 1) || " ")
end
   
procedure ltranf(jjjj)
   return(" " || repl(".", jjjj + lextra - 1) || " ")
end
   
procedure ltranr(kkkk)
   return(" " || repl("^", kkkk + lextra - 1) || " ")
end

procedure avoid(linein,sno,val) # avoid should not occur in line
   if linein ? find(sno) then {
      write("Error line = ",lineno, sno, " conflicts with internal value. (unlikely)")
      write(&errout, "Error line = ",lineno, sno, " conflicts with internal value. (unlikely)")
      write("May change in dot_to_paren.icn")
      write(&errout, "May change in dot_to_paren.icn")
      exit(1)
      }
   else {
      while linein ? (part1 := tab(find(val)) &
                      tab(match(".")) &
                      part2 := tab(0)) do {
                         linein := part1 || sno || part2
                         }
      }
   return linein
end

procedure restore_avoided(linein,sno,val) # avoid should not occur in line
   while linein ? (part1 := tab(find(sno)) &
                   tab(match(sno)) &
                   part2 := tab(0)) do {
                      linein := part1 || val || part2
                      }
   return linein
end

# for groups I and III 
procedure sub_dot(linein, dot_str, dots_out)
   while linein ? ((part1 := tab(find(dot_str))) & 
                   tab(match(dot_str)) & 
                   (part2 := tab(0))) do {
                      linein := part1 || dots_out || part2
                      }
   lineout := linein
   return lineout 
end 

procedure sub_dot_leading(linein, dot_str, dots_out)
   # write("% LEADING in ", linein)
   if linein ? (tab(match(dot_str)) & 
             (part2 := tab(0))) then
      {
         linein :=  dots_out || part2
         lineout := linein
         # write("% LEADING out ", lineout)
         return lineout 
         }
   else {
         # write("% FAILED LEADING out ", lineout)
         fail
         }

end 


# to put quantifier symbol for "TEMP" value
procedure sub_temp(linein, temp)
   while linein ? (part1 := tab(find("TEMP")) &
      tab(match("TEMP")) &
      part2 := tab(0)) do {
         linein := part1 || temp || part2
         }
   return linein
end

# see how many opening paren to start with
procedure scan(linein)
   tot_dots := 0
   i := 1
   while i <= *linein do {
      if linein[i] == "." then tot_dots +:= 1 
      if linein[i] == "!" then tot_dots +:= 1 
      if linein[i] == "^" then tot_dots +:= 1 
      if linein[i] == "%" then tot_dots +:= 1 
      i +:= 1
      }    
   return (tot_dots)
end


procedure trim_excess(line)
   line := trim(line)
   line ? (part1 := tab(find("(")) & # part 1 is string up to 1st paren
           part2 := tab(find("$")) & # part 2 is rest through the end
           part3 := tab(match("$")))
           
   i := 2
   it := part2
   j := *part2
   sav := part2
   while ((part2[i] == "(") & (part2[j] == ")")) do {
      it := part2[i:j]
      part2 := it
      i := 2
      j := *part2
      if check(it) == 1 then { 
         sav := it
         next
            }
      else break
         }
   return part1 || sav || "$"
end

procedure check(line)
   # make sure not too many paren removed
   leftp := 0
   rightp := 0
   i := 1
   while i <= *line do {
      if line[i] == "(" then leftp +:= 1      
      if line[i] == ")" then rightp +:= 1
      if rightp > leftp then fail
      i +:= 1
      }
   return 1
end

procedure quantifier_next(linein, i)
   temp := linein[i:0]
   if temp ? (tab(many('.') & (tab(match(qexist)) | tab(match(qall))) | tab(match(qdsc)))) then {
      write(&errout, QUANTIFIER_NEXT = 1)
      return 1
      }
   else fail
end
procedure next_paren(charin)
# DIRECTION
   it := charin
   if it == "." then return ")"   # before logical
   if it == "^" then return "("   # after logical
   if it == "!" then return ")"   # before quant
   if it == "%" then return "("   # after quant
   if it == ";" then return ")"   # before and
   if it == ":" then return "("   # after and
   return it
end

procedure append_lineout(lineout, str)
   return (lineout || str)
end

# The Main work
procedure analyze(first_dots, linein)
   write(" ")
   # write("% Original = ", linein)
   write(" ")
   lineout := ""
   ddd := find("^", linein)
   linein ? ((front  := tab(ddd)) & (linework := tab(0)))  
   linein := linework

   write(" ")
   # write("% Stripped = ", linein)
   write(" ")

   lineout := repl("(", first_dots)
   dots := first_dots
   len_in := *linein 
   i := 1
   while i <= len_in do {
      charin := linein[i]
      charout := next_paren(charin)
      if charout == "(" then
         dots +:= 1
      else if charout == ")" then
         dots -:= 1
      lineout := append_lineout(lineout, charout)
      i +:= 1 # increment position in current line
      }
   # at end of line output line with enough closing parens to balance
   lineout := front || lineout
   lineout := reverse(lineout)
   lineout ? (part1 := tab(find("$")) & tab(match("$")) & part2 := tab(0))
   lineout := part1 || part2
   lineout := reverse(lineout)
   return (lineout || repl(")", dots) || "$") 
end


